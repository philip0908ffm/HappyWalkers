# Kopieren nach .env und anpassen. NIE echte Schlüssel ins Repository!
NODE_ENV=development
PORT=3000
# Neon: „Pooled connection“-URL aus dem Neon-Dashboard (mit ?sslmode=require)
DATABASE_URL=postgres://gehmeinsam:gehmeinsam@localhost:5432/gehmeinsam
# Adresse, unter der die App im Browser erreichbar ist (Entwicklung: Vite auf 5173)
APP_URL=http://localhost:5173
# Zufällige lange Zeichenkette: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-bitte-in-produktion-aendern
# Resend (https://resend.com) – ohne Schlüssel werden E-Mails nur im Terminal angezeigt
RESEND_API_KEY=
EMAIL_FROM=Gehmeinsam <hallo@ihre-domain.de>
# SMS-Anmeldung: console (Code im Terminal) oder none (aus)
SMS_PROVIDER=console
# Speicherort für Fotos (auf Railway: Pfad des Volumes, z. B. /data/uploads)
UPLOAD_DIR=./uploads
# Premium: dev (Freischaltung ohne Zahlung, nur Entwicklung) oder none
BILLING_PROVIDER=dev
# Weitere erlaubte Herkünfte, z. B. für die Mobil-App (kommagetrennt)
TRUSTED_ORIGINS=
